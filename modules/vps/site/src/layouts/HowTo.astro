---
// How-to 一篇：面包屑、标题、适用于谁、正文、同类文章（中英文共用，语言看路径）
import Site from "./Site.astro";
import Feedback from "../components/Feedback.astro";
import { HOWTO_FLAT, howtoHref, stepHref, STEPS, link, langOf, t } from "../data/nav.js";
const { frontmatter, headings = [] } = Astro.props;
const lang = langOf(Astro.url.pathname);
const en = lang === "en";
const me = HOWTO_FLAT.find((h) => h.slug === frontmatter.slug);
if (!me) throw new Error(`HOWTO 里没有 ${frontmatter.slug}`);
const group = en ? me.groupEn : me.group;
const sameGroup = HOWTO_FLAT.filter((h) => h.group === me.group && h.slug !== me.slug);
const step = frontmatter.step !== undefined ? STEPS.find((s) => s.n === frontmatter.step) : null;
const title = t(me, "title", lang);
---
<Site title={title} description={frontmatter.description} headings={headings}>
  <header class="step-head">
    <ol class="xxd-breadcrumbs" data-size="sm"><li><a href={link("/howto/", lang)}>How-to</a></li><li>{group}</li><li aria-current="page">{title}</li></ol>
    <h1>{title}</h1>
    <div class="step-head__meta">
      {frontmatter.time && <span class="xxd-badge">{frontmatter.time}</span>}
      {frontmatter.for && <span class="xxd-badge">{en ? "For: " : "适用："}{frontmatter.for}</span>}
      {step && <a class="xxd-badge" href={stepHref(step, lang)}>{en ? `Main guide step ${step.n}: ` : `主线第 ${step.n} 步：`}{t(step, "title", lang)}</a>}
    </div>
  </header>
  <article class="xxd-prose"><slot /></article>
  <Feedback page={`How-to: ${title}`} />
  {sameGroup.length > 0 && (
    <nav class="related" aria-label={en ? "Related articles" : "同类文章"}>
      <p class="related__title">{en ? `More in “${group}”` : `「${group}」的其他文章`}</p>
      <ul>{sameGroup.map((h) => <li><a class="xxd-link" href={howtoHref(h.slug, lang)}>{t(h, "title", lang)}</a></li>)}</ul>
    </nav>
  )}
</Site>
